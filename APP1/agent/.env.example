# HiBeam Homelab Agent config. Copy to APP1/agent/.env (gitignored) and fill in.

# Required. Generate with: openssl rand -hex 24
AGENT_TOKEN=

# live = this machine's real stats. demo = simulated homelab "crypt-01" that moves on
# every refresh but reads nothing from this machine. Use demo for public / judges' boards.
# In demo mode SERVICES, ACCESS_LOG and DISK_PATH are ignored.
AGENT_MODE=demo

# Where the agent listens. Keep it on loopback and let nginx proxy to it.
AGENT_HOST=127.0.0.1
AGENT_PORT=9480

# Name shown on the dashboard (defaults to the machine's hostname).
HOST_LABEL=homelab

# How often to sample, and how many samples /history keeps (HiBeam reads at most 100 rows).
SAMPLE_SECONDS=30
HISTORY_SIZE=100

# Filesystem to report disk usage for.
DISK_PATH=/

# systemd units to report as alive/dead, comma-separated.
SERVICES=nginx,ssh,wg-quick@wg0,fail2ban

# Web server access log served at /logs/access (client IPs are masked). Leave empty to disable.
# The agent's user needs read access (e.g. add it to the `adm` group).
ACCESS_LOG=/var/log/nginx/access.log
LOG_LINES=100
