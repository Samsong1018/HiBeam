# MCP server credentials for hibeam-server.mjs
# Copy this file to mcp/.env and fill it in. The server loads it on startup.
# mcp/.env is gitignored, never commit it.

# Base URL of your running HiBeam server.
# Change the port if you set PORT= in the project root .env.
HIBEAM_BASE_URL=http://localhost:8000

# A HiBeam account the MCP server will log in as.
# Create a dedicated account via the signup page if you don't want
# to use your personal credentials here.
HIBEAM_USERNAME=
HIBEAM_PASSWORD=
