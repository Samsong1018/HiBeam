# Copy to .env and fill in. Never commit .env. Get real values from a teammate over a private channel.

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOURCE_KEY_SECRET=
# Public base URL of the app. Emailed links (password reset, email confirm) are built from it,
# so it must be set to the real https URL in production.
APP_BASE_URL=http://localhost:8000

# Optional: Resend API key for password-reset and email-confirm mail (https://resend.com).
# Leave empty in development: links are printed to the server log instead.
# Use a "Sending access" key restricted to the somab.dev domain.
RESEND_API_KEY=
# Optional: sender, must be on a domain verified in Resend (default "HiBeam <hibeam@somab.dev>")
MAIL_FROM=

# DB is reached through an SSH tunnel; keep this running in a terminal:
#   ssh -N -L 3306:127.0.0.1:3306 dbtunnel@<db-host>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional: port to listen on (default 8000)
PORT=8000
# Optional: set when running behind a reverse proxy (e.g. nginx) so rate limits see real client
# IPs. A hop count ("1") or "loopback". Leave unset when clients connect directly.
TRUST_PROXY=
# Set to "production" when serving over HTTPS: enables Secure cookies and HSTS.
NODE_ENV=

# Optional: username of the showcase account for the one-click demo on the login page.
# Its PUBLIC boards, and the sources they read, are copied into each throwaway demo account.
# Leave empty to turn the demo off.
DEMO_SEED_USER=
